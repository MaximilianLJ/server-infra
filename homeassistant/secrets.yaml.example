# Example secrets.yaml for Home Assistant
# Copy this file to secrets.yaml and replace the values with your actual secrets

# Home Assistant
ha_password: "your_home_assistant_password"

# MQTT
mqtt_username: "your_mqtt_username"
mqtt_password: "your_mqtt_password"

# Weather
openweathermap_api_key: "your_openweathermap_api_key"

# Notifications
pushover_api_key: "your_pushover_api_key"
pushover_user_key: "your_pushover_user_key"

# Other
some_api_key: "your_some_api_key"
another_secret: "your_another_secret"