# Paperless-ngx environment variables example
# Copy this file to .env and adjust the values as needed

# Database configuration
PAPERLESS_DBHOST=localhost
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=paperless

# Redis configuration
PAPERLESS_REDIS=redis://localhost:6379

# Secret key for Django
PAPERLESS_SECRET_KEY=change-this-to-a-random-secret-key

# Time zone
PAPERLESS_TIME_ZONE=UTC

# OCR settings
PAPERLESS_OCR_LANGUAGE=eng

# Webserver settings
PAPERLESS_PORT=8000
PAPERLESS_URL=http://localhost:8000

# Optional: Enable debug mode
# PAPERLESS_DEBUG=true

# Optional: Admin user creation
# PAPERLESS_ADMIN_USER=admin
# PAPERLESS_ADMIN_PASSWORD=admin

# Optional: Paths
# PAPERLESS_CONSUMPTION_DIR=/path/to/consumption/dir
# PAPERLESS_DATA_DIR=/path/to/data/dir
# PAPERLESS_MEDIA_ROOT=/path/to/media/root